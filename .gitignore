# Local .terraform directories
**/.terraform/*
#Deployment script
deploy_infra.ps1

# State files
*.tfstate
*.tfstate.*

# Plan files
*.tfplan
tfplan

# Crash logs
crash.log
crash.*.log

# Variable files (may contain secrets)
*.tfvars
*.tfvars.json
!*.tfvars.example

# Override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# CLI config
.terraformrc
terraform.rc

# Secrets
.env
*.pem
*.key